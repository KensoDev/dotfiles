{
  # Copy this file to ~/.config/git-user.nix and fill in your personal details
  # Keeping secrets outside the flake is the Nix-native way to handle private config
  # The flake imports this file using an absolute path, bypassing git tracking

  user = {
    email = "your-email@example.com";
    name = "Your Name";
  };

  github.user = "your-github-username";

  includes = [
    # Example: load different config for work repositories
    # {
    #   condition = "gitdir:~/Code/work/";
    #   path = "~/.gitconfig-work";
    # }
  ];
}
